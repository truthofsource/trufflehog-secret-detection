name: TruffleHog contract tests

# Synthetic Git fixtures only. This workflow never scans Workforce history.
on:
  pull_request:
    branches:
      - main
    paths:
      - .github/workflows/trufflehog-*.yml
      - scripts/trufflehog_*.py
      - scripts/test_trufflehog*.py
      - security/trufflehog-*.json
  push:
    branches:
      - main
    paths:
      - .github/workflows/trufflehog-*.yml
      - scripts/trufflehog_*.py
      - scripts/test_trufflehog*.py
      - security/trufflehog-*.json

permissions:
  contents: read

jobs:
  synthetic:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Test isolated scanner contract
        run: python3 -B -m unittest discover -s scripts -p 'test_trufflehog*.py'

  pinned-container:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    timeout-minutes: 4
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - name: Test pinned Linux container against synthetic Git history
        env:
          WORKFORCE_TRUFFLEHOG_CONTAINER: '1'
        run: python3 -B -m unittest discover -s scripts -p test_trufflehog_scan.py -k test_linux_container_finds_removed_synthetic_private_key
